# Copy to apps/pwa/.env.local. Leave everything empty to run the in-browser demo backend.

# --- Supabase (Project Settings → API) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Cloudflare R2 photo storage ---
# "true" uploads through the r2-upload edge function. Otherwise photos go to the
# Supabase Storage "photos" bucket created by migration 20261023000004_storage.sql.
VITE_R2_ENABLED=

# --- Firebase Cloud Messaging (web push) ---
# Project settings → General → Your apps → Web app config, as one-line JSON:
# {"apiKey":"…","authDomain":"…","projectId":"…","messagingSenderId":"…","appId":"…"}
VITE_FIREBASE_CONFIG=
# Project settings → Cloud Messaging → Web Push certificates → key pair
VITE_FIREBASE_VAPID_KEY=
