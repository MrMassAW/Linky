{
  "name": "linky",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @linky/pwa dev",
    "build": "pnpm --filter @linky/pwa build",
    "preview": "pnpm --filter @linky/pwa preview",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "gen:cities": "node scripts/gen-cities.mjs",
    "gen:seed-sql": "tsx scripts/gen-seed-sql.ts",
    "sync:shared": "node scripts/sync-shared.mjs",
    "build:static": "cd apps/pwa && LINKY_STATIC=1 vite build --outDir dist-static --emptyOutDir"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "all-the-cities": "3.1.0",
    "cities.json": "1.1.65",
    "fake-indexeddb": "^6.2.6",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "core-js"
    ]
  }
}
